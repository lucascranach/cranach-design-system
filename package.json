{
  "name": "@lucascranach/design-system",
  "version": "0.0.0",
  "description": "Cranach Design System – gemeinsame Design-Tokens, Grundstyles und Komponenten für die Frontends des Cranach Digital Archive",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucascranach/cranach-design-system.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./cranach.css": "./dist/cranach.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./custom-media.css": "./dist/custom-media.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./figma/tokens.figma.json": "./dist/figma/tokens.figma.json"
  },
  "style": "./dist/cranach.css",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:tokens": "node build/build-tokens.mjs",
    "build:icons": "node build/build-icons.mjs",
    "build:css": "node build/build-css.mjs",
    "build:figma": "node build/build-figma.mjs",
    "check:contrast": "node build/check-contrast.mjs",
    "lint:css": "stylelint \"src/**/*.css\" \".storybook/**/*.css\"",
    "test:lint": "node --test build/stylelint.test.mjs",
    "test:figma": "node --test build/figma-sync.test.mjs",
    "build": "npm run lint:css && npm run build:tokens && npm run build:icons && npm run build:css && npm run build:figma && npm run check:contrast",
    "prepublishOnly": "npm run build",
    "storybook": "npm run build && storybook dev -p 6006 --no-open",
    "build:storybook": "npm run build && storybook build -o storybook-static"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/html-vite": "10.6.5",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.5",
    "style-dictionary": "5.6.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "vite": "8.3.5"
  }
}
