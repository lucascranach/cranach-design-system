{
  "color": {
    "$type": "color",
    "background": {
      "default": { "$value": "{color.neutral.900}", "$description": "Seitenhintergrund" },
      "subtle": { "$value": "{color.neutral.800}", "$description": "Leicht abgesetzte Fläche (Karten, Seitenleisten)" },
      "medium": { "$value": "{color.neutral.700}", "$description": "Mittlere Stufe zwischen subtle und strong, Hover-Fläche neutraler Elemente (ADR 0019)" },
      "strong": { "$value": "{color.neutral.600}", "$description": "Kräftig abgesetzte Fläche, z. B. Hover des grauen Buttons" },
      "inverse": { "$value": "{color.neutral.0}" },
      "overlay": { "$value": "{color.alpha.black-60}", "$description": "Abdunkelung hinter Dialogen und Viewer" }
    },
    "text": {
      "default": { "$value": "{color.neutral.100}" },
      "muted": { "$value": "{color.neutral.300}", "$description": "Nebeninformationen, mind. 4,5:1" },
      "inverse": { "$value": "{color.neutral.1000}" },
      "accent": { "$value": "{color.yellow.500}", "$description": "Farbig betonter Text" },
      "decoration": { "$value": "{color.orange.300}", "$description": "Dekorationsfarbe als Text (Orange)" },
      "danger": { "$value": "{color.red.300}" },
      "on-accent": { "$value": "{color.neutral.1000}", "$description": "Text auf Gelb – immer dunkel" }
    },
    "accent": {
      "default": { "$value": "{color.yellow.500}", "$description": "Markenfarbe, nur als Fläche" },
      "hover": { "$value": "{color.yellow.400}" },
      "subtle": { "$value": "{color.yellow.900}", "$description": "Zarte Hervorhebung, z. B. ausgewählte Zeile" }
    },
    "link": {
      "default": { "$value": "{color.yellow.500}" },
      "underline": { "$value": "{color.yellow.500}", "$description": "Mind. 3:1 gegen den Hintergrund (ADR 0018)" },
      "hover-background": { "$value": "{color.yellow.500}" },
      "hover-text": { "$value": "{color.neutral.1000}" }
    },
    "border": {
      "default": { "$value": "{color.neutral.700}", "$description": "Dekorative Trennlinien" },
      "strong": { "$value": "{color.neutral.400}", "$description": "Rahmen von Bedienelementen, mind. 3:1" },
      "hover": { "$value": "{color.neutral.500}", "$description": "Linie unter Navigationseinträgen beim Überfahren; ohne Mindestkontrast, der Tastaturfokus hat seinen eigenen Ring" }
    },
    "feedback": {
      "$description": "Rückmeldungen (Komponente Meldung): zarte Fläche, kräftiger Rand und Symbol; Text bleibt text.default.",
      "info": {
        "background": { "$value": "{color.yellow.900}", "$description": "Fläche einer Meldung: Hinweis" },
        "border": { "$value": "{color.yellow.500}", "$description": "Rand und Symbol einer Meldung: Hinweis, mind. 3:1" }
      },
      "success": {
        "background": { "$value": "{color.green.900}", "$description": "Fläche einer Meldung: Erfolg" },
        "border": { "$value": "{color.green.300}", "$description": "Rand und Symbol einer Meldung: Erfolg, mind. 3:1" }
      },
      "danger": {
        "background": { "$value": "{color.red.900}", "$description": "Fläche einer Meldung: Fehler" },
        "border": { "$value": "{color.red.300}", "$description": "Rand und Symbol einer Meldung: Fehler, mind. 3:1" }
      }
    },
    "focus": {
      "ring": { "$value": "{color.yellow.500}", "$description": "Fokusring, mind. 3:1 gegen den Hintergrund" }
    }
  }
}
