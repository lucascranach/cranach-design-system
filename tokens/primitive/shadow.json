{
  "shadow": {
    "$type": "shadow",
    "$description": "Aus cranach-search ($shadow, $shadow-s, $shadow-m) auf 16-px-Basis umgerechnet.",
    "s": { "$value": { "color": "{color.alpha.black-40}", "offsetX": "1px", "offsetY": "1px", "blur": "4px", "spread": "0px" } },
    "m": { "$value": { "color": "{color.alpha.black-40}", "offsetX": "1px", "offsetY": "1px", "blur": "12px", "spread": "0px" } },
    "l": { "$value": { "color": "{color.alpha.black-40}", "offsetX": "1px", "offsetY": "1px", "blur": "20px", "spread": "0px" } }
  }
}
